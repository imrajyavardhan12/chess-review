# Cloudflare Pages headers (also applied by scripts/serve-dist.mjs for local and CI runs).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; worker-src 'self'; connect-src 'self' https://api.chess.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build output never changes for a given URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The engine files keep a stable name, so cache them long but let a deploy replace them within a day.
/engine/*
  Cache-Control: public, max-age=86400

# The shell must be revalidated so a new deploy is picked up.
/index.html
  Cache-Control: no-cache

# The service worker must be revalidated too, so browsers see a new version promptly.
/sw.js
  Cache-Control: no-cache
