{
  "name": "chessreview",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "pnpm --filter @chessreview/web dev",
    "build": "pnpm --filter @chessreview/web build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "node scripts/build-openings.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "e2e": "pnpm build && pnpm --filter @chessreview/web e2e",
    "review-games": "node --experimental-transform-types --no-warnings --import ./scripts/ts-hooks.mjs scripts/review-games.ts",
    "explain-corpus": "node --experimental-transform-types --no-warnings --import ./scripts/ts-hooks.mjs scripts/explain-corpus.ts",
    "tactics-eval": "node --experimental-transform-types --no-warnings --import ./scripts/ts-hooks.mjs scripts/tactics-eval.ts",
    "budget": "node scripts/check-bundle.mjs",
    "label-audit": "node --experimental-transform-types --no-warnings --import ./scripts/ts-hooks.mjs scripts/label-audit.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "chess.js": "^1.4.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.34.6"
}
